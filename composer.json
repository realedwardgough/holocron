{
    "name": "egough/holocron",
    "description": "A Laravel package for recording and querying historical events across your application.",
    "keywords": [
        "laravel",
        "history",
        "audit",
        "timeline",
        "activity",
        "models"
    ],
    "homepage": "https://github.com/realedwardgough/holocron",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "dev-main",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Egough\\Holocron\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Egough\\Holocron\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Edward Gough",
            "email": "edwardggough@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Egough\\Holocron\\HolocronServiceProvider"
            ],
            "aliases": {
                "Holocron": "Egough\\Holocron\\Facades\\Holocron"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
